. /*===========================================================================
> ===
>   INCISO 1.2 — ENIGH: ingreso laboral por persona (collapse -> merge -> appen
> d)
>   Para cada año:
>     (1) Tabla de ingresos: nos quedamos con las claves de ingreso por trabajo
>         (remuneraciones + negocios propios + cooperativas, según la
>         clasificación del INEGI/CONEVAL de cada levantamiento).
>     (2) collapse: sumamos todas las claves laborales de cada persona.
>     (3) merge 1:1 con la tabla de población (todas las personas del hogar).
>     (4) Guardamos un archivo por año y al final los unimos con append.
> =============================================================================
> =*/
. if $corre_1_2 {
. capture mkdir "$data/construidas/enigh"
. 
. *----------------------------------------------------------------------------
> --
. * 1.2.a Claves de ingreso laboral por año (validadas contra el concentrado IN
> EGI)
. *----------------------------------------------------------------------------
> --
. global lab1992 `"inrange(clave,"P001","P011") | clave=="P013""'
. foreach y in 1994 1996 {
  2.     global lab`y' `"inrange(clave,"P001","P015")"'
  3. }
. foreach y in 1998 2000 {
  2.     global lab`y' `"inrange(clave,"P001","P019")"'
  3. }
. global lab2002 `"inrange(clave,"P001","P020") | inlist(clave,"P022","P023")"'
. foreach y in 2004 2005 2006 {
  2.     global lab`y' `"inrange(clave,"P001","P027") | inrange(clave,"P029","P
> 038")"'
  3. }
. foreach y in 2008 2010 2012 2014 2016 2018 2020 2022 2024 {
  2.     global lab`y' `"inrange(clave,"P001","P009") | inrange(clave,"P011","P
> 016") | inrange(clave,"P018","P022") | inrange(clave,"P067","P081")"'
  3. }
. 
. *----------------------------------------------------------------------------
> --
. * 1.2.b Ciclo por año: ingresos -> collapse -> merge con población
. *----------------------------------------------------------------------------
> --
. foreach y of global enigh_years {
  2. 
.     di _n as res "================  ENIGH `y'  ================"
  3. 
.     * --- (1) Tabla de INGRESOS -------------------------------------------
.     if strpos("${ing`y'}", ".dbf") {
  4.         import dbase using "$enigh/`y'/${ing`y'}", clear case(lower)
  5.     }
  6.     else {
  7.         use "$enigh/`y'/${ing`y'}", clear
  8.         rename *, lower
  9.     }
 10. 
.     * Identificador del hogar homogéneo (folio) y de la persona (numren)
.     capture confirm variable folioviv
 11.     if _rc == 0 {
 12.         capture tostring folioviv foliohog, replace format(%15.0f)
 13.         gen str30 folio = folioviv + "_" + foliohog
 14.     }
 15.     else {
 16.         capture tostring folio, replace format(%15.0f)
 17.     }
 18.     capture rename num_ren numren
 19.     destring numren, replace
 20. 
.     * Ingreso del mes pasado: su nombre cambia entre años
.     capture rename ing_mp ing_1                 // 1992
 21.     capture rename ing1   ing_1                 // 1994 y 1996
 22.     destring ing_1 ing_tri, replace
 23. 
.     * Solo claves de ingreso por trabajo
.     replace clave = upper(trim(clave))
 24.     keep if ${lab`y'}
 25. 
.     * 2008-2024: utilidades (P008, P015) y aguinaldo (P009, P016) se captan
.     * como un monto anual en ing_1; no corresponden al mes pasado.
.     if `y' >= 2008 {
 26.         replace ing_1 = 0 if inlist(clave, "P008", "P009", "P015", "P016")
 27.     }
 28. 
.     * 1992: montos en "viejos pesos" -> nuevos pesos (1 N$ = 1,000 $)
.     if `y' == 1992 {
 29.         replace ing_1   = ing_1   / 1000
 30.         replace ing_tri = ing_tri / 1000
 31.     }
 32. 
.     * --- (2) collapse: un renglón por persona ------------------------------
.     collapse (sum) ing_lab_mp = ing_1 ing_lab_tri = ing_tri ///
>              (count) n_lab = ing_tri, by(folio numren)
 33.     tempfile ing`y'
 34.     save `ing`y''
 35. 
.     * --- (3) Tabla de POBLACIÓN y merge ------------------------------------
> -
.     if strpos("${pob`y'}", ".dbf") {
 36.         import dbase using "$enigh/`y'/${pob`y'}", clear case(lower)
 37.     }
 38.     else {
 39.         use "$enigh/`y'/${pob`y'}", clear
 40.         rename *, lower
 41.     }
 42.     capture confirm variable folioviv
 43.     if _rc == 0 {
 44.         capture tostring folioviv foliohog, replace format(%15.0f)
 45.         gen str30 folio = folioviv + "_" + foliohog
 46.     }
 47.     else {
 48.         capture tostring folio, replace format(%15.0f)
 49.     }
 50.     capture rename num_ren numren
 51.     destring numren, replace
 52.     isid folio numren                           // una fila por persona
 53. 
.     merge 1:1 folio numren using `ing`y''
 54.     tab _merge
 55.     count if _merge == 2
 56.     if r(N) > 0 di as err "ATENCIÓN `y': `r(N)' personas con ingreso sin r
> egistro en población"
 57.     drop if _merge == 2
 58. 
.     gen byte con_ing_lab = (_merge == 3)        // 1 = reportó alguna clave l
> aboral
 59.     drop _merge
 60.     foreach v in ing_lab_mp ing_lab_tri n_lab {
 61.         replace `v' = 0 if con_ing_lab == 0
 62.     }
 63. 
.     * --- (4) Año y guardado ------------------------------------------------
> --
.     gen int year = `y'
 64.     compress
 65.     save "$data/construidas/enigh/enigh_pob_ing_`y'.dta", replace
 66. }

