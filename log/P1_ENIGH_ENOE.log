. *----------------------------------------------------------------------------
> --
. * 1.3.c ENIGH: variables armonizadas por año
. *----------------------------------------------------------------------------
> --
. if $corre_1_3 {
. foreach y of global enigh_years {
  2. 
.     di _n as res "================  ENIGH `y' (1.3)  ================"
  3. 
.     * --- Hogar: factor de expansión y tamaño de localidad ------------------
> -
.     if strpos("${con`y'}", ".dbf") {
  4.         import dbase using "$enigh/`y'/${con`y'}", clear case(lower)
  5.     }
  6.     else {
  7.         use "$enigh/`y'/${con`y'}", clear
  8.         rename *, lower
  9.     }
 10.     capture confirm variable folioviv
 11.     if _rc == 0 {
 12.         capture tostring folioviv foliohog, replace format(%15.0f)
 13.         gen str30 folio = folioviv + "_" + foliohog
 14.     }
 15.     else {
 16.         capture tostring folio, replace format(%15.0f)
 17.     }
 18.     capture rename hog        factor                  // 1992-2006
 19.     capture rename factor_hog factor                  // 2012-2014
 20.     capture rename estrato    tam_loc                 // 1992-2008: estrat
> o; 2010+: tam_loc
 21.     destring factor tam_loc, replace
 22.     gen byte rural = (tam_loc == 4)                   // localidades de me
> nos de 2,500 hab.
 23.     keep folio factor rural
 24.     tempfile hog
 25.     save `hog'
 26. 
.     * --- Horas trabajadas 2008+: tabla de trabajos (suma de todos los empleo
> s)
.     if `y' >= 2008 {
 27.         use "$enigh/`y'/${tra`y'}", clear
 28.         rename *, lower
 29.         capture tostring folioviv foliohog, replace format(%15.0f)
 30.         gen str30 folio = folioviv + "_" + foliohog
 31.         destring numren htrab, replace
 32.         collapse (sum) horas = htrab, by(folio numren)
 33.         tempfile hrs
 34.         save `hrs'
 35.     }
 36. 
.     * --- Personas (archivo del inciso 1.2) ---------------------------------
> --
.     use "$data/construidas/enigh/enigh_pob_ing_`y'.dta", clear
 37.     destring sexo edad, replace
 38. 
.     * Años de escolaridad según el esquema de cada levantamiento
.     if inlist(`y', 1992, 1994) {                      // nivel terminado (0-9
> )
 39.         destring ed_formal, replace
 40.         recode ed_formal (0=0) (1=3) (2=6) (3=7) (4=9) (5=10) (6=12) ///
>                          (7=14) (8=16) (9=18) (else=.), gen(educ_anios)
 41.     }
 42.     else if inlist(`y', 1996, 1998, 2000) {           // último grado apro
> bado (00-16)
 43.         destring ed_formal, replace
 44.         recode ed_formal (0 1=0) (2=1) (3=2) (4=3) (5=4) (6=5) (7=6) (8=7)
>  ///
>                          (9=8) (10=9) (11=10) (12=12) (13=14) (14=16) (15=18)
>  ///
>                          (16=8) (else=.), gen(educ_anios)
 45.     }
 46.     else if `y' == 2002 {                             // grado o semestre 
> aprobado (00-33)
 47.         destring ed_formal, replace
 48.         recode ed_formal (0/2=0) (3=1) (4=2) (5=3) (6=4) (7=5) (8=6) (9=7)
>  ///
>                          (10=8) (11 12=9) (13 14 17=10) (15 16=11) (18 19=12)
>  ///
>                          (20 21=13) (22 23=13) (24 25 30=14) (26 27=15) ///
>                          (28 29=16) (31=17) (32=18) (33=20) (else=.), gen(edu
> c_anios)
 49.     }
 50.     else {                                            // 2004+: nivel + gr
> ado + antecedente
 51.         capture rename n_instr161 niv
 52.         capture rename n_instr141 niv
 53.         capture rename nivelaprob niv
 54.         capture rename n_instr162 gra
 55.         capture rename n_instr142 gra
 56.         capture rename gradoaprob gra
 57.         destring niv gra antec_esc, replace
 58.         gen educ_anios = .
 59.         replace educ_anios = 0          if inlist(niv, 0, 1)      // ningu
> no / preescolar
 60.         replace educ_anios = gra        if niv == 2               // prima
> ria
 61.         replace educ_anios = 6  + gra   if niv == 3               // secun
> daria
 62.         replace educ_anios = 9  + gra   if niv == 4               // prepa
> ratoria
 63.         replace educ_anios = 6  + gra   if inlist(niv, 5, 6) & antec_esc =
> = 1   // normal/técnica
 64.         replace educ_anios = 9  + gra   if inlist(niv, 5, 6) & (antec_esc 
> == 2 | missing(antec_esc))
 65.         replace educ_anios = 12 + gra   if inlist(niv, 5, 6) & antec_esc >
> = 3 & !missing(antec_esc)
 66.         replace educ_anios = 12 + gra   if niv == 7               // profe
> sional
 67.         replace educ_anios = 16 + gra   if niv == 8               // maest
> ría
 68.         replace educ_anios = 18 + gra   if niv == 9               // docto
> rado
 69.         replace educ_anios = 24 if educ_anios > 24 & !missing(educ_anios)
 70.     }
 71. 
.     * Horas trabajadas a la semana (todos los trabajos)
.     if `y' <= 2002 {
 72.         capture rename hr_semana  hrs_sem             // 1992
 73.         capture rename hr_sem_sec hrs_sec
 74.         destring hrs_sem hrs_sec, replace
 75.         egen horas = rowtotal(hrs_sem hrs_sec)
 76.     }
 77.     else if `y' <= 2006 {
 78.         capture rename horastrab horas_trab           // 2004
 79.         destring horas_trab, replace
 80.         gen horas = horas_trab
 81.         replace horas = 0 if missing(horas)           // vacío = no trabaj
> ó (en 2004 viene vacío)
 82.     }
 83.     else {
 84.         merge 1:1 folio numren using `hrs', keep(master match) nogenerate
 85.         replace horas = 0 if missing(horas)           // sin registro en t
> rabajos = no trabajó
 86.     }
 87. 
.     * Hogar: factor y rural
.     merge m:1 folio using `hog', keep(master match) nogenerate
 88. 
.     keep year folio numren sexo edad educ_anios horas rural factor ///
>          ing_lab_mp ing_lab_tri con_ing_lab
 89.     tempfile p`y'
 90.     save `p`y''
 91. }

