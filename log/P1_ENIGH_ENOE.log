. /*===========================================================================
> ===
>   INCISO 1.11 — ENIGH: ingreso corriente per cápita del hogar (INEGI) y
>   líneas de pobreza por ingresos (CONEVAL)
>   Ingreso per cápita = ingreso corriente trimestral del hogar / 3 / integrant
> es
> =============================================================================
> =*/
. foreach y of global enigh_years {
  2.     if strpos("${con`y'}", ".dbf") {
  3.         import dbase using "$enigh/`y'/${con`y'}", clear case(lower)
  4.     }
  5.     else {
  6.         use "$enigh/`y'/${con`y'}", clear
  7.         rename *, lower
  8.     }
  9.     capture confirm variable folioviv
 10.     if _rc == 0 {
 11.         capture tostring folioviv foliohog, replace format(%15.0f)
 12.         gen str30 folio = folioviv + "_" + foliohog
 13.     }
 14.     else {
 15.         capture tostring folio, replace format(%15.0f)
 16.     }
 17.     capture rename hog        factor
 18.     capture rename factor_hog factor
 19.     capture rename estrato    tam_loc
 20.     capture rename ing_cor    ingcor
 21.     capture rename tot_integ  tam_hog
 22.     destring factor tam_loc ingcor tam_hog, replace
 23.     if `y' == 1992 replace ingcor = ingcor / 1000             // viejos pe
> sos
 24.     gen byte rural = (tam_loc == 4)
 25.     gen int year = `y'
 26.     keep year folio factor rural ingcor tam_hog
 27.     tempfile h`y'
 28.     save `h`y''
 29. }
