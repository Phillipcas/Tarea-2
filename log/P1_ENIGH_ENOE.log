. /*===========================================================================
> ===
>   INCISOS 1.4 a 1.9 — se repiten para la ENIGH y para la ENOE
> =============================================================================
> =*/
. foreach enc in enigh enoe {
  2. 
.     if "`enc'" == "enigh" {
  3.         use "$data/construidas/enigh_1992_2024_limpia.dta", clear
  4.         local ENC    "ENIGH"
  5.         local xl     "1992(8)2024"
  6.         local fuente "Fuente: elaboración propia con datos de la ENIGH (IN
> EGI), 1992-2024."
  7.         local nc     = 3                                  // numeración de
>  cuadros
  8.     }
  9.     else {
 10.         use "$data/construidas/enoe_2005_2026_limpia.dta", clear
 11.         local ENC    "ENOE"
 12.         local xl     "2005(5)2025"
 13.         local fuente "Fuente: elaboración propia con datos de la ENOE (INE
> GI), 2005-2026; todos los trimestres, sin ETOE."
 14.         local nc     = 7
 15.     }
 16.     di _n as res "=====================  `ENC': incisos 1.4 a 1.9  =======
> =============="
 17. 
.     *------------------------------------------------------------------------
> --
.     * 1.4 Ocho grupos: sexo x edad (25-45, 46-65) x escolaridad (< prepa, >= 
> prepa)
.     *------------------------------------------------------------------------
> --
.     capture drop edad_g grupo
 18.     gen byte edad_g = (edad >= 46)
 19.     gen byte grupo  = 1 + 4*mujer + 2*edad_g + prepa_o_mas
 20.     label define lgrupo 1 "Hombres, 25-45, sin prepa"   2 "Hombres, 25-45,
>  prepa o más" ///
>                         3 "Hombres, 46-65, sin prepa"   4 "Hombres, 46-65, pr
> epa o más" ///
>                         5 "Mujeres, 25-45, sin prepa"   6 "Mujeres, 25-45, pr
> epa o más" ///
>                         7 "Mujeres, 46-65, sin prepa"   8 "Mujeres, 46-65, pr
> epa o más" ///
>                         9 "Total", replace
 21.     label values grupo lgrupo
 22.     label var grupo "Grupo sexo-edad-escolaridad"
 23.     tab grupo
 24. 
.     *------------------------------------------------------------------------
> --
.     * 1.5 Salario válido y variable trabajo
.     *   999998/999999 = no sabe/no responde -> faltante (antes de pasar a rea
> l)
.     *   Salario 0 -> tampoco se usa
.     *------------------------------------------------------------------------
> --
.     capture drop salario_nom salario trabajo
 25.     if "`enc'" == "enigh" {
 26.         gen double salario_nom = ing_lab_mp
 27.     }
 28.     else {
 29.         capture destring p6b2, replace
 30.         di as txt "ENOE: p6b2 = 999998 (no sabe) y 999999 (no responde), p
> or año"
 31.         gen byte no_sabe  = (p6b2 == 999998)
 32.         gen byte no_resp  = (p6b2 == 999999)
 33.         table year, statistic(sum no_sabe no_resp) nformat(%12.0fc)
 34.         gen double salario_nom = ingocup
 35.         replace salario_nom = . if inlist(p6b2, 999998, 999999)
 36.         drop no_sabe no_resp
 37.         di as txt "ENOE: proporción de ocupados con ingreso 0 (no declaran
>  monto), ponderada"
 38.         gen byte ocup_ing0 = (ingocup == 0) if clase2 == 1
 39.         table year [aw=factor], statistic(mean ocup_ing0) nformat(%5.3f)
 40.         table trimestre year [aw=factor] if year >= 2023, statistic(mean o
> cup_ing0) nformat(%5.3f)
 41.         drop ocup_ing0
 42.     }
 43.     if "`enc'" == "enoe" {
 44.         count if salario_nom >= 999998 & !missing(salario_nom)
 45.         replace salario_nom = . if salario_nom >= 999998
 46.     }
 47.     count if salario_nom == 0
 48.     di as txt "`ENC': salarios iguales a cero que no se usan = `r(N)'"
 49.     replace salario_nom = . if salario_nom == 0
 50.     gen double salario = ing_mp_real if !missing(salario_nom)     // pesos
>  de enero 2026
 51.     gen byte trabajo = !missing(salario)
 52.     label var salario "Salario mensual (pesos de enero de 2026)"
 53.     label var trabajo "Trabajador: salario válido (1=sí)"
 54.     drop salario_nom
 55. 
.     *------------------------------------------------------------------------
> --
.     * 1.6 Salario por hora y censura en 1 y 5,000
.     *------------------------------------------------------------------------
> --
.     capture drop w_hora ln_w cens_bajo cens_alto muestra_w
 56.     gen double w_hora = salario / (horas * 4.33) if horas > 0 & !missing(s
> alario)
 57.     count if !missing(salario) & (horas == 0 | missing(horas))
 58.     di as txt "`ENC': salario válido pero 0 horas (sin salario por hora) =
>  `r(N)'"
 59.     gen byte cens_bajo = (w_hora < 1)
 60.     gen byte cens_alto = (w_hora > 5000 & !missing(w_hora))
 61.     di as txt "`ENC': observaciones censuradas por año"
 62.     table year, statistic(sum cens_bajo cens_alto) statistic(count w_hora)
>  nformat(%12.0fc)
 63.     count if cens_bajo
 64.     di as res "`ENC': salarios por hora < 1 cambiados a 1 = `r(N)'"
 65.     count if cens_alto
 66.     di as res "`ENC': salarios por hora > 5,000 cambiados a 5,000 = `r(N)'
> "
 67.     replace w_hora = 1    if cens_bajo
 68.     replace w_hora = 5000 if cens_alto
 69.     gen double ln_w = ln(w_hora)
 70.     gen byte muestra_w = !missing(w_hora)
 71.     label var w_hora    "Salario por hora (pesos de enero de 2026)"
 72.     label var ln_w      "Log del salario por hora"
 73.     label var muestra_w "Salario por hora válido (1=sí)"
 74.     label var cens_bajo "Salario por hora censurado en 1"
 75.     label var cens_alto "Salario por hora censurado en 5,000"
 76. 
.     compress
 77.     save "$data/construidas/`enc'_limpia_salarios.dta", replace
 78. 
.     *------------------------------------------------------------------------
> --
.     * 1.7 Box plots del log del salario por hora (ponderados)
.     *------------------------------------------------------------------------
> --
.     * Etiquetas del eje x: cada 4 años (ENIGH) o cada 5 (ENOE); las demás en 
> blanco
.     levelsof year if muestra_w, local(anios)
 79.     local rl ""
 80.     local i = 0
 81.     foreach a of local anios {
 82.         local ++i
 83.         if ("`enc'" == "enigh" & mod(`a' - 1992, 4) == 0) | ("`enc'" == "e
> noe" & mod(`a', 5) == 0) {
 84.             local rl `rl' `i' "`a'"
 85.         }
 86.         else {
 87.             local rl `rl' `i' " "
 88.         }
 89.     }
 90. 
.     local opbox over(year, relabel(`rl') label(labsize($gtam))) ///
>         box(1, fcolor("$c1%35") lcolor("$c1")) medtype(line) medline(lcolor("
> $c1") lwidth(medthick)) ///
>         ytitle("Log del salario por hora", size($gtam)) b1title("Año", size($
> gtam)) ///
>         ylabel(, labsize($gtam) angle(horizontal) format(%3.0f) grid glcolor(
> gs14)) ///
>         $gfig
 91. 
.     graph box ln_w [aw=factor] if muestra_w, `opbox' ///
>         marker(1, msymbol(point) mcolor(gs10)) ///
>         note("Nota: caja = percentiles 25 a 75; línea interior = mediana; big
> otes = 1.5 veces el rango intercuartil." ///
>              "Puntos = valores atípicos. Ponderado con el factor de expansión
> ." ///
>              "`fuente'", size(small) span)
 92.     graph export "$out/Fig_1_7_`enc'_boxplot_con_atipicos.png", width(2400
> ) replace
 93. 
.     graph box ln_w [aw=factor] if muestra_w, `opbox' nooutsides ///
>         note("Nota: caja = percentiles 25 a 75; línea interior = mediana; big
> otes = 1.5 veces el rango intercuartil." ///
>              "No se grafican los valores atípicos. Ponderado con el factor de
>  expansión." ///
>              "`fuente'", size(small) span)
 94.     graph export "$out/Fig_1_7_`enc'_boxplot_sin_atipicos.png", width(2400
> ) replace
 95. 
.     *------------------------------------------------------------------------
> --
.     * 1.8.a aweight vs fweight (salario por hora, por año)
.     *------------------------------------------------------------------------
> --
.     capture noisily summarize w_hora [fw=factor] if muestra_w
 96.     if _rc di as err "`ENC': fweight no se puede usar con el factor origin
> al (no es entero)."
 97.     else  di as res "`ENC': el factor original ya es entero; fweight sí se
>  puede usar."
 98.     capture drop factor_int
 99.     gen long factor_int = round(factor)
100. 
.     tempname pf
101.     tempfile cmp
102.     postfile `pf' int year double(media_aw ee_aw n_aw media_fw ee_fw n_fw)
>  using `cmp', replace
103.     levelsof year if muestra_w, local(anios)
104.     foreach a of local anios {
105.         quietly mean w_hora [aw=factor] if muestra_w & year == `a'
106.         matrix T = r(table)
107.         local m1 = T[1,1]
108.         local s1 = T[2,1]
109.         local n1 = e(N)
110.         quietly mean w_hora [fw=factor_int] if muestra_w & year == `a'
111.         matrix T = r(table)
112.         post `pf' (`a') (`m1') (`s1') (`n1') (T[1,1]) (T[2,1]) (e(N))
113.     }
114.     postclose `pf'
115.     preserve
116.         use `cmp', clear
117.         label var year     "Año"
118.         label var media_aw "Media (aweight)"
119.         label var ee_aw    "Error estándar (aweight)"
120.         label var n_aw     "N (aweight)"
121.         label var media_fw "Media (fweight)"
122.         label var ee_fw    "Error estándar (fweight)"
123.         label var n_fw     "N (fweight)"
124.         list, noobs abbreviate(12) separator(0)
125.         * Formato largo: un renglón por año y tipo de peso (encabezado en 
> dos niveles)
.         rename (media_aw ee_aw n_aw media_fw ee_fw n_fw) (media1 ee1 n1 media
> 2 ee2 n2)
126.         reshape long media ee n, i(year) j(metodo)
127.         label define lmet 1 "aweight" 2 "fweight", replace
128.         label values metodo lmet
129.         label var media "Media"
130.         label var ee    "Error estándar"
131.         label var n     "N"
132.         table (year) (metodo var), statistic(mean media ee n) nototals
133.         estilo_cuadro
134.         collect style header metodo, title(hide)
135.         collect style cell var[media], nformat(%9.2f)
136.         collect style cell var[ee], nformat(%9.4f)
137.         collect style cell var[n], nformat(%15.0fc)
138.         collect label dim year "Año", modify
139.         collect title "Cuadro `nc'. `ENC': salario por hora promedio con a
> weight y fweight (pesos de enero de 2026)"
140.         exporta_cuadro, archivo("$out/Cuadro`nc'_`enc'_aweight_fweight") /
> //
>             nota("Nota: fweight usa el factor de expansión redondeado a enter
> o. N: observaciones de la muestra (aweight) o población representada (fweight
> ).") ///
>             fuente("`fuente'")
141.     restore
142. 
.     *------------------------------------------------------------------------
> --
.     * 1.8.b y 1.9 Medias ponderadas por año y grupo (aweight)
.     *   Salario y salario por hora: solo quienes tienen salario por hora váli
> do
.     *   Proporción de trabajadores: toda la población de 25 a 65 años
.     *------------------------------------------------------------------------
> --
.     preserve
143.         collapse (mean) w_hora salario [aw=factor] if muestra_w, by(year g
> rupo)
144.         tempfile g1
145.         save `g1'
146.     restore
147.     preserve
148.         collapse (mean) w_hora salario [aw=factor] if muestra_w, by(year)
149.         gen byte grupo = 9
150.         append using `g1'
151.         tempfile g2
152.         save `g2'
153.     restore
154.     preserve
155.         collapse (mean) trabajo [aw=factor], by(year grupo)
156.         tempfile g3
157.         save `g3'
158.     restore
159.     preserve
160.         collapse (mean) trabajo [aw=factor], by(year)
161.         gen byte grupo = 9
162.         append using `g3'
163.         merge 1:1 year grupo using `g2', nogenerate
164.         replace trabajo = 100 * trabajo
165.         label values grupo lgrupo
166.         gen byte sexo_g = cond(grupo <= 4, 1, cond(grupo <= 8, 2, 3))
167.         gen byte sub_g  = cond(grupo == 9, 5, mod(grupo - 1, 4) + 1)
168.         label define lsexo 1 "Hombres" 2 "Mujeres" 3 "Total", replace
169.         label define lsub  1 "25-45, sin prepa" 2 "25-45, prepa o más" ///
>                            3 "46-65, sin prepa" 4 "46-65, prepa o más" 5 "Tod
> os", replace
170.         label values sexo_g lsexo
171.         label values sub_g lsub
172.         * Dimensiones para el encabezado de los cuadros: sexo > edad > esc
> olaridad
.         gen byte edad_c = cond(grupo == 9, 3, cond(inlist(sub_g, 1, 2), 1, 2)
> )
173.         gen byte educ_c = cond(grupo == 9, 3, cond(inlist(sub_g, 1, 3), 1,
>  2))
174.         label define lsexoc 1 "Hombres" 2 "Mujeres" 3 " ", replace
175.         label define ledadc 1 "25-45 años" 2 "46-65 años" 3 "Total", repla
> ce
176.         label define leducc 1 "Sin prepa" 2 "Prepa o más" 3 " ", replace
177.         label values edad_c ledadc
178.         label values educ_c leducc
179.         label var w_hora  "Salario por hora"
180.         label var salario "Salario mensual"
181.         label var trabajo "Trabajadores (%)"
182.         sort grupo year
183.         save "$data/construidas/`enc'_resultados_grupos.dta", replace
184. 
.         * Cuadros (años en renglones; sexo y grupo en columnas)
.         local k = 0
185.         foreach v in w_hora salario trabajo {
186.             local ++k
187.             local n = `nc' + `k'
188.             if "`v'" == "w_hora"  local tit "salario por hora promedio por
>  grupo (pesos de enero de 2026)"
189.             if "`v'" == "salario" local tit "salario mensual promedio por 
> grupo (pesos de enero de 2026)"
190.             if "`v'" == "trabajo" local tit "porcentaje de trabajadores (c
> on salario válido) por grupo"
191.             if "`v'" == "w_hora"  local fmt "%9.1f"
192.             if "`v'" == "salario" local fmt "%12.0fc"
193.             if "`v'" == "trabajo" local fmt "%9.1f"
194.             label values sexo_g lsexoc
195.             table (year) (sexo_g edad_c educ_c), statistic(mean `v') notot
> als nformat(`fmt')
196.             estilo_cuadro, size(8)
197.             collect style header sexo_g edad_c educ_c, title(hide)
198.             capture noisily collect style header sexo_g[3] educ_c[3], leve
> l(hide)
199.             collect label dim year "Año", modify
200.             collect title "Cuadro `n'. `ENC': `tit'"
201.             if "`v'" != "trabajo" local nt "Nota: medias ponderadas con el
>  factor de expansión (aweight); personas de 25 a 65 años con salario por hora
>  válido. Prepa o más: preparatoria completa (12 años de escolaridad o más)."
202.             else local nt "Nota: medias ponderadas con el factor de expans
> ión (aweight); población de 25 a 65 años. Trabajador: salario positivo y decl
> arado. Prepa o más: preparatoria completa (12 años de escolaridad o más)."
203.             exporta_cuadro, archivo("$out/Cuadro`n'_`enc'_`v'_grupos") not
> a("`nt'") fuente("`fuente'")
204.         }
205.         label values sexo_g lsexo
206. 
.         * Gráficas por grupo (inciso 1.8)
.         graf_grupos w_hora, ytitulo("Pesos por hora (enero de 2026)") ///
>             archivo("$out/Fig_1_8_`enc'_salario_hora_grupos.png") xlab(`xl') 
> formato("%9.0f") ///
>             nota("Nota: medias ponderadas con el factor de expansión (aweight
> ); personas de 25 a 65 años" ///
>                  "con salario por hora válido. Prepa o más: preparatoria comp
> leta (12 años de escolaridad o más)." ///
>                  "`fuente'")
207.         graf_grupos salario, ytitulo("Pesos al mes (enero de 2026)") ///
>             archivo("$out/Fig_1_8_`enc'_salario_mensual_grupos.png") xlab(`xl
> ') ///
>             nota("Nota: medias ponderadas con el factor de expansión (aweight
> ); personas de 25 a 65 años" ///
>                  "con salario por hora válido. Prepa o más: preparatoria comp
> leta (12 años de escolaridad o más)." ///
>                  "`fuente'")
208.     restore
