. /*===========================================================================
> ===
>   5.3 Ancho de banda y kernel (ENIGH 2024, logaritmo del ingreso)
> =============================================================================
> =*/
. keep if year == 2024 & !missing(ln_ingpc)
(324,072 observations deleted)

. kdensity ln_ingpc [aw = w_pers], nograph

. local h = r(bwidth)

. di as res "Ancho de banda de Silverman (Epanechnikov): " %6.4f `h'
Ancho de banda de Silverman (Epanechnikov): 0.0652

. local hbig   = 4 * `h'

. local hsmall = `h' / 8

. foreach v in base big small gau rect {
  2.     capture drop x_`v' d_`v'
  3. }

. gen double x_base = 5 + 7 * (_n - 1) / 499 in 1/500                 // rejill
> a común de 500 puntos entre 5 y 12
(90,908 missing values generated)

. foreach v in big small gau rect {
  2.     gen double x_`v' = x_base
  3. }
(90,908 missing values generated)
(90,908 missing values generated)
(90,908 missing values generated)
(90,908 missing values generated)

. kdensity ln_ingpc [aw = w_pers], at(x_base)  bwidth(`h')      generate(d_base
> ) nograph

. kdensity ln_ingpc [aw = w_pers], at(x_big)   bwidth(`hbig')   generate(d_big)
>  nograph

. kdensity ln_ingpc [aw = w_pers], at(x_small) bwidth(`hsmall') generate(d_smal
> l) nograph

. kdensity ln_ingpc [aw = w_pers], at(x_gau)   bwidth(`h') kernel(gaussian)  ge
> nerate(d_gau) nograph

. kdensity ln_ingpc [aw = w_pers], at(x_rect)  bwidth(`h') kernel(rectangle) ge
> nerate(d_rect) nograph

