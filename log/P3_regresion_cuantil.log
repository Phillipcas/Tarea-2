. /*===========================================================================
> ===
>   3.4 (y 3.5) Regresión cuantil y MCO por año
>   ln(w) = b0 + b1 escolaridad + b2 edad + b3 edad^2 + b4 rural + b5 mujer
>   Cuantiles 1 a 99; errores estándar robustos; ponderado con el factor.
> =============================================================================
> =*/
. if $corre_qreg {
. use "$data/construidas/p3_base.dta", clear
. tempname pq
. tempfile coef
. postfile `pq' byte enc int year byte q str10 var double(b se) using `coef', r
> eplace
(file C:\Users\LCASTI~1\AppData\Local\Temp\ST_1ad8_000003.tmp not found)
. levelsof enc, local(encs)
1 2
. foreach e of local encs {
  2.     levelsof year if enc == `e', local(anios)
  3.     foreach a of local anios {
  4.         * MCO (q = 0)
.         quietly regress ln_w educ_anios edad edad2 rural mujer [pw = factor] 
> if enc == `e' & year == `a'
  5.         foreach v in educ_anios edad edad2 rural mujer {
  6.             post `pq' (`e') (`a') (0) ("`v'") (_b[`v']) (_se[`v'])
  7.         }
  8.         forvalues q = 1/99 {
  9.             quietly qreg ln_w educ_anios edad edad2 rural mujer [pw = fact
> or] if enc == `e' & year == `a', ///
>                 quantile(`=`q'/100') vce(robust)
 10.             foreach v in educ_anios edad edad2 rural mujer {
 11.                 post `pq' (`e') (`a') (`q') ("`v'") (_b[`v']) (_se[`v'])
 12.             }
 13.         }
 14.         di as res "Encuesta `e', año `a': listo"
 15.     }
 16. }
2018 2024
Encuesta 1, año 2018: listo
Encuesta 1, año 2024: listo
2006 2016 2026
Encuesta 2, año 2006: listo
Encuesta 2, año 2016: listo
Encuesta 2, año 2026: listo
. postclose `pq'
. use `coef', clear
. gen double lo = b - invnormal(0.975) * se
. gen double hi = b + invnormal(0.975) * se
. save "$data/construidas/p3_coeficientes.dta", replace
file C:/Users/lcastillo/Music/TAREA 2/data/construidas/p3_coeficientes.dta
    saved
. }

