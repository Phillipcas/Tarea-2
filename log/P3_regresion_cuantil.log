. /*===========================================================================
> ===
>   3.3 (y 3.5) Cambio del log del salario por hora en cada cuantil, por sexo
>   Percentiles 1 a 99 ponderados con el factor de expansión.
> =============================================================================
> =*/
. tempname pf

. tempfile cuant

. postfile `pf' byte enc int year byte mujer byte q double valor using `cuant',
>  replace
(file C:\Users\LCASTI~1\AppData\Local\Temp\ST_1ad8_000002.tmp not found)

. foreach e in 1 2 {
  2.     levelsof year if enc == `e', local(anios)
  3.     foreach a of local anios {
  4.         forvalues s = 0/1 {
  5.             quietly _pctile ln_w [pw = factor] if enc == `e' & year == `a'
>  & mujer == `s', nquantiles(100)
  6.             forvalues q = 1/99 {
  7.                 post `pf' (`e') (`a') (`s') (`q') (r(r`q'))
  8.             }
  9.         }
 10.     }
 11. }
2018 2024
2006 2016 2026

. postclose `pf'

. use `cuant', clear

