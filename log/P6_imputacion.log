. /*===========================================================================
> ===
>   6.5 Réplica de Campos-Vázquez (2013), 2005-2026: imputación de ingresos
>   (1) Hot-deck con bootstrap bayesiano aproximado (Rubin y Schenker, 1986)
>   (2) Mediana del grupo más ruido normal (mediana + DE x N(0,1))
>   Receptores: ocupados remunerados que no declaran monto. Donadores: ocupados
>   remunerados con ingreso declarado positivo. Celdas: trimestre x rango de
>   salarios mínimos (si lo declaró) x sexo x edad x escolaridad x formalidad x
>   rural; si una celda no tiene donadores se usa una celda más amplia.
>   5 imputaciones múltiples; los resultados son el promedio de las 5.
> =============================================================================
> =*/
. if $corre_imput {
. use "$data/construidas/p6_enoe_personas_def.dta", clear
. gen long pid = _n
. * Rango de salarios mínimos de los donadores (mismas categorías que p6c)
. gen double razon = p6b2 / salario if remun & p6b2 > 0 & !missing(p6b2)
(23,076,411 missing values generated)
. gen byte rng = .
(33,845,060 missing values generated)
. replace rng = 1 if razon <= 1
(2,276,105 real changes made)
. replace rng = 3 if razon > 1 & razon <= 2
(3,441,810 real changes made)
. replace rng = 4 if razon > 2 & razon <= 3
(2,334,618 real changes made)
. replace rng = 5 if razon > 3 & razon <= 5
(1,770,287 real changes made)
. replace rng = 6 if razon > 5 & razon <= 10
(750,405 real changes made)
. replace rng = 7 if razon > 10 & !missing(razon)
(195,424 real changes made)
. replace rng = p6c if nodecl & inrange(p6c, 1, 7)
(1,420,344 real changes made)
. replace rng = 3 if rng == 2                                  // "1 salario mí
> nimo" se agrupa con 1 a 2
(257,197 real changes made)
. replace rng = 0 if nodecl & missing(rng)
(1,685,042 real changes made)
. gen byte don = remun & p6b2 > 0 & !missing(p6b2)
. gen byte rec = nodecl
. replace edg = 0 if missing(edg)
(42,853 real changes made)
. replace formal = 0 if missing(formal)
(19,971,025 real changes made)
. tempfile trabajo
. keep if don | rec
(19,971,025 observations deleted)
. keep pid dateq rng sex eg edg formal rural don rec p6b2
. save `trabajo'
file C:\Users\LCASTI~1\AppData\Local\Temp\ST_25ec_00000j.tmp saved as .dta
    format
. 
. capture program drop imputa
. program define imputa
  1.     * Asigna a los receptores sin valor un donador de la misma celda (hot-
> deck con ABB)
.     * o la mediana + ruido de la celda. Argumentos: variables de celda y méto
> do.
.     syntax varlist, METodo(string) GEN(name)
  2.     tempvar cel u rk n0 j pool
  3.     egen long `cel' = group(`varlist'), missing
  4.     gen double `u' = runiform()
  5.     sort `cel' don `u'
  6.     by `cel' don: gen long `rk' = _n if don
  7.     by `cel': egen long `n0' = total(don)
  8.     if "`metodo'" == "hotdeck" {
  9.         * Paso 1 (ABB): la posición j del "pool" de cada celda recibe un d
> onador al azar
.         gen long `pool' = ceil(runiform() * `n0') if don
 10.         * Paso 2: cada receptor sin valor elige una posición j del pool
.         gen long `j' = ceil(runiform() * `n0') if rec & missing(`gen') & `n0'
>  > 0
 11.         preserve
 12.             keep if don
 13.             keep `cel' `rk' `pool' p6b2
 14.             tempfile D
 15.             save `D'
 16.             rename (`rk' `pool') (`j' donr)
 17.             keep `cel' `j' donr
 18.             tempfile A
 19.             save `A'
 20.             use `D', clear
 21.             rename (`rk' p6b2) (donr valor)
 22.             keep `cel' donr valor
 23.             tempfile B
 24.             save `B'
 25.         restore
 26.         merge m:1 `cel' `j' using `A', keep(master match) nogenerate     /
> / posición -> donador del pool
 27.         merge m:1 `cel' donr using `B', keep(master match) nogenerate    /
> / donador -> su ingreso
 28.         replace `gen' = valor if rec & missing(`gen') & !missing(valor)
 29.         drop donr valor
 30.     }
 31.     else {
 32.         tempvar med sd
 33.         by `cel': egen double `med' = median(cond(don, p6b2, .))
 34.         by `cel': egen double `sd'  = sd(cond(don, p6b2, .))
 35.         replace `sd' = 0 if missing(`sd')
 36.         tempvar z
 37.         gen double `z' = `med' + `sd' * rnormal() if rec & missing(`gen') 
> & `n0' > 0
 38.         forvalues k = 1/5 {
 39.             replace `z' = `med' + `sd' * rnormal() if rec & missing(`gen')
>  & `n0' > 0 & `z' <= 0
 40.         }
 41.         replace `z' = `med' if rec & missing(`gen') & `n0' > 0 & `z' <= 0
 42.         replace `gen' = `z' if rec & missing(`gen') & !missing(`z')
 43.     }
 44. end
. 
. forvalues m = 1/$M {
  2.     foreach met in hotdeck mediana {
  3.         use `trabajo', clear
  4.         gen double imp = .
  5.         * Con rango de salarios mínimos: primero dentro del mismo rango
.         imputa dateq rng sex eg edg formal rural, metodo(`met') gen(imp)
  6.         imputa dateq rng sex edg formal, metodo(`met') gen(imp)
  7.         * Sin rango (o sin donador en su rango): celdas sin la variable de
>  rango
.         imputa dateq sex eg edg formal rural, metodo(`met') gen(imp)
  8.         imputa dateq sex edg formal, metodo(`met') gen(imp)
  9.         imputa dateq edg, metodo(`met') gen(imp)
 10.         count if rec & missing(imp)
 11.         di as txt "`met' `m': receptores sin imputar = " r(N)
 12.         keep if rec
 13.         keep pid imp
 14.         rename imp imp_`met'_`m'
 15.         tempfile i_`met'_`m'
 16.         save `i_`met'_`m''
 17.     }
 18. }
