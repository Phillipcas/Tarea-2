. /*===========================================================================
> ===
>   4.3 El mismo ejercicio con bsample (repeticiones programadas a mano)
>   En cada réplica se guarda coeficiente, error estándar robusto y t. El
>   jackknife se calcula con la fórmula exacta de "dejar uno fuera" de MCO:
>   b(-i) = b - (X'X)^-1 x_i e_i / (1 - h_i), sin volver a estimar N veces.
> =============================================================================
> =*/
. capture program drop manual

. program define manual
  1.     syntax, BASE(string) ETiq(string) RES(string)
  2.     use "`base'", clear
  3.     local N = _N
  4.     quietly regress ln_w $x, vce(robust)
  5.     foreach v of global x {
  6.         local b_`v'  = _b[`v']
  7.         local se_`v' = _se[`v']
  8.     }
  9.     tempname pf
 10.     postfile `pf' str12 metodo int reps str10 var double(b se lo_p hi_p lo
> _t hi_t tstat) using "`res'", replace
 11.     foreach tam in N m {
 12.         local sz = cond("`tam'" == "N", `N', floor(`N' / 4))
 13.         local nombre = cond("`tam'" == "N", "Bootstrap", "Bootstrap m")
 14.         foreach R in 100 1000 {
 15.             tempname pr
 16.             tempfile rep
 17.             postfile `pr' int r double(b_educ_anios se_educ_anios b_edad s
> e_edad b_edad2 se_edad2 b_rural se_rural b_mujer se_mujer) using `rep', repla
> ce
 18.             forvalues r = 1/`R' {
 19.                 preserve
 20.                     bsample `sz'
 21.                     quietly regress ln_w $x, vce(robust)
 22.                     post `pr' (`r') (_b[educ_anios]) (_se[educ_anios]) (_b
> [edad]) (_se[edad]) (_b[edad2]) (_se[edad2]) ///
>                         (_b[rural]) (_se[rural]) (_b[mujer]) (_se[mujer])
 23.                 restore
 24.             }
 25.             postclose `pr'
 26.             preserve
 27.                 use `rep', clear
 28.                 if "`tam'" == "N" & `R' == 1000 save "$data/construidas/p4
> _replicas_`etiq'.dta", replace
 29.                 foreach v of global x {
 30.                     quietly summarize b_`v'
 31.                     local seb = r(sd)
 32.                     _pctile b_`v', percentiles(2.5 97.5)
 33.                     local lp = r(r1)
 34.                     local hp = r(r2)
 35.                     percentil_t, v(`v') b(`b_`v'') se(`se_`v'')
 36.                     post `pf' ("`nombre'") (`R') ("`v'") (`b_`v'') (`seb')
>  (`lp') (`hp') (r(lo)) (r(hi)) (`b_`v'' / `seb')
 37.                 }
 38.             restore
 39.         }
 40.     }
 41.     * Jackknife exacto con la fórmula de dejar uno fuera (N y 0.25 N)
.     foreach tam in N m {
 42.         preserve
 43.             if "`tam'" == "m" sample 25
 44.             local n = _N
 45.             quietly regress ln_w $x
 46.             mata: jk_ols("ln_w", "$x")
 47.             local k = 0
 48.             foreach v of global x {
 49.                 local ++k
 50.                 local bj = el(JK, 1, `k')
 51.                 local sj = el(JK, 2, `k')
 52.                 local nombre = cond("`tam'" == "N", "Jackknife", "Jackknif
> e m")
 53.                 post `pf' ("`nombre'") (`n') ("`v'") (`bj') (`sj') (`bj' -
>  invnormal(.975) * `sj') (`bj' + invnormal(.975) * `sj') (.) (.) (`bj' / `sj'
> )
 54.             }
 55.         restore
 56.     }
 57.     postclose `pf'
 58.     use "`res'", clear
 59.     gen str10 base = "`etiq'"
 60.     save "`res'", replace
 61. end

. 
. mata:
------------------------------------------------- mata (type end to exit) -----
: void jk_ols(string scalar yv, string scalar xv)
> {
>     real matrix X, XXi, Bi
>     real colvector y, e, h
>     real rowvector b, bbar, sej
>     real scalar n
>     y   = st_data(., yv)
>     X   = (st_data(., tokens(xv)), J(rows(y), 1, 1))
>     n   = rows(X)
>     XXi = invsym(cross(X, X))
>     b   = (XXi * cross(X, y))'
>     e   = y - X * b'
>     h   = rowsum((X * XXi) :* X)
>     Bi  = b :- ((X * XXi) :* (e :/ (1 :- h)))       // coeficientes al dejar 
> fuera a i
>     bbar = mean(Bi)
>     sej  = sqrt((n - 1) / n * colsum((Bi :- bbar) :^ 2))
>     st_matrix("JK", (b[1..cols(b)-1] \ sej[1..cols(sej)-1]))
> }

: end
