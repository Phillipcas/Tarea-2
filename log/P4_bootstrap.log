. /*===========================================================================
> ===
>   Cuadros (uno por base y forma de cálculo) para los coeficientes de
>   escolaridad y mujer
> =============================================================================
> =*/
. local n = 0

. foreach b in enigh enoe {
  2.     foreach f in comandos manual {
  3.         local ++n
  4.         use "$data/construidas/p4_res_`b'_`f'.dta", clear
  5.         rename var coef
  6.         keep if inlist(coef, "educ_anios", "mujer")
  7.         gen byte orden = cond(metodo == "MCO robusto", 1, cond(metodo == "
> Bootstrap", 2, cond(metodo == "Bootstrap m", 3, cond(metodo == "Jackknife", 4
> , 5))))
  8.         gen str40 fila = metodo + cond(inlist(metodo, "Bootstrap", "Bootst
> rap m"), " (" + string(reps) + " rep.)", "")
  9.         replace fila = "MCO, EE robusto" if metodo == "MCO robusto"
 10.         replace fila = subinstr(fila, "Bootstrap m", "Bootstrap 0.25 N", 1
> )
 11.         replace fila = subinstr(fila, "Jackknife m", "Jackknife 0.25 N", 1
> )
 12.         replace reps = 0 if missing(reps)               // jackknife con N
> : N no cabe en int; sin este cambio group() lo omite
 13.         sort orden reps
 14.         egen int fid = group(orden reps)
 15.         levelsof fid, local(fids)
 16.         foreach i of local fids {
 17.             levelsof fila if fid == `i', local(lab) clean
 18.             label define lfila `i' "`lab'", add
 19.         }
 20.         label values fid lfila
 21.         gen byte vcoef = cond(coef == "educ_anios", 1, 2)
 22.         label define lvcoef 1 "Escolaridad" 2 "Mujer", replace
 23.         label values vcoef lvcoef
 24.         label var b    "Coef."
 25.         label var se   "E.E."
 26.         label var lo_p "Percentil inf."
 27.         label var hi_p "Percentil sup."
 28.         label var lo_t "Percentil-t inf."
 29.         label var hi_t "Percentil-t sup."
 30.         label var tstat "t"
 31.         table (vcoef fid) (var), statistic(mean b se lo_p hi_p lo_t hi_t t
> stat) nototals   // escolaridad y mujer en bloques de renglones
 32.         estilo_cuadro, size(9)
 33.         collect style header vcoef fid, title(hide)
 34.         collect style cell, nformat(%9.4f)
 35.         collect style cell var[tstat], nformat(%9.1f)
 36.         local B = cond("`b'" == "enigh", "ENIGH 2024", "ENOE 2026, trimest
> re II")
 37.         local F = cond("`f'" == "comandos", "comandos bootstrap y jackknif
> e", "réplicas con bsample")
 38.         collect title "Cuadro 4.`n'. `B': errores estándar e intervalos de
>  confianza al 95% (`F')"
 39.         local fte = cond("`b'" == "enigh", "Fuente: elaboración propia con
>  datos de la ENIGH 2024 (INEGI).", "Fuente: elaboración propia con datos de l
> a ENOE 2026, trimestre II (INEGI).")
 40.         exporta_cuadro, archivo("$out/Cuadro_4_`n'_`b'_`f'") ///
>             nota("Nota: MCO del log del salario por hora sobre escolaridad, e
> dad, edad al cuadrado, rural y mujer, sin factor de expansión. En MCO y jackk
> nife el intervalo es el normal (coeficiente ± 1.96 E.E.); en bootstrap, el pe
> rcentil usa los cuantiles 2.5 y 97.5 de los coeficientes y el percentil-t los
>  de t* = (b* - b) / E.E.*. Con 0.25 N el E.E. corresponde a muestras de tamañ
> o N/4. t = coeficiente / E.E.") ///
>             fuente("`fte'")
 41.     }
 42. }
