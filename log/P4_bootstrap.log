. /*===========================================================================
> ===
>   Programa que hace todo el ejercicio para una base:
>     (a)  bootstrap no paramétrico con 100 y 1,000 repeticiones (comando boots
> trap)
>     (b)  jackknife (comando jackknife)
>     (c)  bootstrap con submuestras de 0.25 N (opción size())
>     (d)  jackknife con una submuestra aleatoria de 0.25 N
>   y lo guarda en una base de resultados (un renglón por método y coeficiente)
> .
>   Para cada coeficiente se guardan: coeficiente de MCO, error estándar
>   (robusto o de remuestreo), IC percentil al 95% y IC percentil-t al 95%.
> =============================================================================
> =*/
. capture program drop percentil_t

. program define percentil_t, rclass
  1.     * Recibe una base con b_v y se_v por réplica; devuelve cuantiles 2.5 y
>  97.5 de t*
.     syntax, v(string) b(real) se(real)
  2.     tempvar t
  3.     gen double `t' = (b_`v' - `b') / se_`v'
  4.     _pctile `t', percentiles(2.5 97.5)
  5.     return scalar lo = `b' - r(r2) * `se'
  6.     return scalar hi = `b' - r(r1) * `se'
  7. end

. 
. capture program drop ejercicio

. program define ejercicio
  1.     syntax, BASE(string) ETiq(string) RES(string)
  2.     use "`base'", clear
  3.     local N = _N
  4.     tempname pf
  5.     postfile `pf' str12 metodo int reps str10 var double(b se lo_p hi_p lo
> _t hi_t tstat) using "`res'", replace
  6. 
.     * --- MCO con errores robustos (referencia)
.     regress ln_w $x, vce(robust)
  7.     foreach v of global x {
  8.         local b_`v'  = _b[`v']
  9.         local se_`v' = _se[`v']
 10.         post `pf' ("MCO robusto") (0) ("`v'") (_b[`v']) (_se[`v']) ///
>             (_b[`v'] - invttail(e(df_r), .025) * _se[`v']) (_b[`v'] + invttai
> l(e(df_r), .025) * _se[`v']) (.) (.) (_b[`v'] / _se[`v'])
 11.     }
 12. 
.     * --- (a) y (c): bootstrap con N y con 0.25 N; 100 y 1,000 repeticiones
.     foreach tam in N m {
 13.         local sz = cond("`tam'" == "N", `N', floor(`N' / 4))
 14.         local nombre = cond("`tam'" == "N", "Bootstrap", "Bootstrap m")
 15.         foreach R in 100 1000 {
 16.             tempfile rep
 17.             quietly bootstrap _b _se, reps(`R') size(`sz') saving(`rep', r
> eplace) nodots: regress ln_w $x, vce(robust)
 18.             preserve
 19.                 use `rep', clear
 20.                 foreach v of global x {
 21.                     rename _b_`v' b_`v'
 22.                     rename _se_`v' se_`v'
 23.                     quietly summarize b_`v'
 24.                     local seb = r(sd)
 25.                     _pctile b_`v', percentiles(2.5 97.5)
 26.                     local lp = r(r1)
 27.                     local hp = r(r2)
 28.                     percentil_t, v(`v') b(`b_`v'') se(`se_`v'')
 29.                     post `pf' ("`nombre'") (`R') ("`v'") (`b_`v'') (`seb')
>  (`lp') (`hp') (r(lo)) (r(hi)) (`b_`v'' / `seb')
 30.                 }
 31.             restore
 32.         }
 33.     }
 34. 
.     * --- (b) jackknife (dejar fuera una observación a la vez)
.     quietly jackknife _b, nodots: regress ln_w $x
 35.     foreach v of global x {
 36.         local sej = _se[`v']
 37.         post `pf' ("Jackknife") (`N') ("`v'") (`b_`v'') (`sej') ///
>             (`b_`v'' - invnormal(.975) * `sej') (`b_`v'' + invnormal(.975) * 
> `sej') (.) (.) (`b_`v'' / `sej')
 38.     }
 39. 
.     * --- (d) jackknife con una submuestra aleatoria de 0.25 N
.     preserve
 40.         sample 25
 41.         local n25 = _N
 42.         quietly regress ln_w $x
 43.         foreach v of global x {
 44.             local b25_`v' = _b[`v']
 45.         }
 46.         quietly jackknife _b, nodots: regress ln_w $x
 47.         foreach v of global x {
 48.             local sej = _se[`v']
 49.             post `pf' ("Jackknife m") (`n25') ("`v'") (`b25_`v'') (`sej') 
> ///
>                 (`b25_`v'' - invnormal(.975) * `sej') (`b25_`v'' + invnormal(
> .975) * `sej') (.) (.) (`b25_`v'' / `sej')
 50.         }
 51.     restore
 52.     postclose `pf'
 53.     use "`res'", clear
 54.     gen str10 base = "`etiq'"
 55.     save "`res'", replace
 56. end

. 
