. foreach v in ta sal {
  2.     * Paso 1: RMSPE previo de las 12 especificaciones
.     local lista ""
  3.     forvalues k = 1/12 {
  4.         local preds = subinstr("`sp`k''", "Y(", "i_`v'(", .)
  5.         quietly synth i_`v' `preds', trunit(33) trperiod(`=tm(2019m1)')
  6.         local rm`k' = el(e(RMSPE), 1, 1)
  7.         local lista "`lista' `=string(`rm`k'', "%012.6f")':`k'"
  8.         di as txt "`v' especificación `k': RMSPE previo = " %6.3f `rm`k''
  9.     }
 10.     * Paso 2: las 10 de menor RMSPE, con valor p por placebos
.     local orden : list sort lista
 11.     local n = 0
 12.     foreach par of local orden {
 13.         local ++n
 14.         if `n' > 10 continue
 15.         local k = substr("`par'", strpos("`par'", ":") + 1, .)
 16.         local preds = subinstr("`sp`k''", "Y(", "i_`v'(", .)
 17.         foreach x in lead effect pre_rmspe post_rmspe i_`v'_synth {
 18.             capture drop `x'                    // una por una: capture dr
> op con lista no borra nada si falta alguna
 19.         }
 20.         synth_runner i_`v' `preds', trunit(33) trperiod(`=tm(2019m1)') gen
> _vars
 21.         local p = e(pval_joint_post)
 22.         summarize effect if unidad == 33 & date >= tm(2019m1), meanonly
 23.         post `pf' ("`v'") (`k') ("`desc`k''") (`rm`k'') (r(mean)) (`p')
 24.         if `n' == 1 {
 25.             * Modelo elegido (menor RMSPE): se guardan la serie sintética 
> y los placebos
.             preserve
 26.                 keep unidad date i_`v' i_`v'_synth effect
 27.                 rename (i_`v' i_`v'_synth effect) (obs sint efecto)
 28.                 gen str3 var = "`v'"
 29.                 tempfile elegido_`v'
 30.                 save `elegido_`v''
 31.             restore
 32.             local mejor_`v' = `k'
 33.         }
 34.     }
 35. }
