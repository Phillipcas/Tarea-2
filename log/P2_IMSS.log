. * Estilo gráfico (mismo estilo A del Problema 1)
. set scheme s2color

. graph set window fontface "Times New Roman"

. global c1   "31 58 104"           // azul marino

. global c2   "200 112 42"          // naranja

. global c3   "46 107 52"           // verde

. global c4   "142 36 50"           // guinda

. global gtam "medsmall"

. global gfig "xsize(6.5) ysize(4.5) graphregion(color(white) margin(small)) pl
> otregion(color(white) lcolor(none))"

. global xmes "xlabel(`=tm(2000m1)'(48)`=tm(2024m1)', format(%tmCCYY) labsize($
> gtam) nogrid)"

. 
. * Estilo y exportación de cuadros (mismos programas del Problema 1)
. capture program drop estilo_cuadro

. program define estilo_cuadro
  1.     syntax [, SIZE(integer 9)]
  2.     collect style header result, level(hide)
  3.     collect style cell border_block, border(right, pattern(nil))
  4.     collect style cell cell_type[column-header corner], font(, bold) shadi
> ng(background(D9D9D9))   // formato C: encabezado gris y en negrita
  5.     collect style cell cell_type[column-header], halign(center)
  6.     collect style cell, font("Times New Roman", size(`size'))
  7.     capture noisily collect style title, font("Times New Roman", size(10))
  8. end

. capture program drop exporta_cuadro

. program define exporta_cuadro
  1.     syntax, ARchivo(string) NOta(string) FUente(string)
  2.     collect export "`archivo'.xlsx", replace
  3.     putdocx clear
  4.     putdocx begin, font("Times New Roman", 10)
  5.     putdocx collect
  6.     putdocx paragraph
  7.     putdocx text ("`nota'"), font("Times New Roman", 8)
  8.     putdocx paragraph
  9.     putdocx text ("`fuente'"), font("Times New Roman", 8)
 10.     putdocx save "`archivo'.docx", replace
 11. end

