. 
. /*===========================================================================
> ===
>   2.0 Construcción de las series a partir de las celdas del IMSS
>   Cada renglón de las bases anuales es una celda (municipio x sexo x edad x
>   rango salarial) con el número de puestos (ta), los puestos con salario
>   (ta_sal) y la masa salarial diaria (masa_sal_ta). Se usan solo celdas con
>   masa salarial positiva. El salario de la celda es masa / ta_sal (salario
>   base de cotización diario promedio); se lleva a mensual multiplicando por
>   30.4 días y a pesos de enero de 2026 con el INPC del mes.
> =============================================================================
> =*/
. if $corre_2_0 {
. tempfile nac mun
. forvalues y = 2000/2026 {
  2.     di as res "================  IMSS `y'  ================"
  3.     use year month cve_entidad cve_municipio sexo ta ta_sal masa_sal_ta //
> /
>         using "$imss/imss_`y'.dta" if masa_sal_ta > 0 & ta_sal > 0, clear
  4.     merge m:1 year month using `defl', keep(match) nogenerate
  5.     gen double masa_r = masa_sal_ta * 30.4 * defl          // masa mensual
>  real
  6.     gen double sal    = masa_r / ta_sal                     // salario men
> sual real de la celda
  7. 
.     * (a) Panel municipal por sexo: sumas
.     preserve
  8.         collapse (sum) ta ta_sal masa_r, by(year month cve_entidad cve_mun
> icipio sexo)
  9.         capture append using `mun'
 10.         save `mun', replace
 11.     restore
 12. 
.     * (b) Serie nacional: percentiles y percentil en que cae la media
.     *     (primero el total, después hombres y mujeres por separado)
.     keep year month sexo ta_sal masa_r sal
 13.     bysort year month: egen double m_g = total(masa_r)
 14.     by year month: egen double n_g = total(ta_sal)
 15.     gen byte bajo = (sal < m_g / n_g)
 16.     preserve
 17.         collapse (mean) pctil_media = bajo (p10) p10 = sal (p25) p25 = sal
>  (p50) p50 = sal ///
>                  (p75) p75 = sal (p90) p90 = sal [fw = ta_sal], by(year month
> )
 18.         gen byte g = 0
 19.         tempfile t0
 20.         save `t0'
 21.     restore
 22.     keep if inlist(sexo, 1, 2)
 23.     drop m_g n_g bajo
 24.     bysort year month sexo: egen double m_g = total(masa_r)
 25.     by year month sexo: egen double n_g = total(ta_sal)
 26.     gen byte bajo = (sal < m_g / n_g)
 27.     collapse (mean) pctil_media = bajo (p10) p10 = sal (p25) p25 = sal (p5
> 0) p50 = sal ///
>              (p75) p75 = sal (p90) p90 = sal [fw = ta_sal], by(year month sex
> o)
 28.     rename sexo g
 29.     append using `t0'
 30.     capture append using `nac'
 31.     save `nac', replace
 32. }
